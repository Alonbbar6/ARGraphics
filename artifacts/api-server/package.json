{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:isolation": "node ./tests/run.mjs",
    "test:storage-smoke": "vitest run --config vitest.storage-smoke.config.ts",
    "test:browser-storage-smoke": "vitest run --config vitest.browser-smoke.config.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@imgly/background-removal-node": "1.4.5",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.3.0",
    "openai": "^7.32.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.64.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "vite": "catalog:",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
