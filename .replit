modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "table-card-ios-regressions"

[[workflows.workflow]]
name = "table-card-ios-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test && pnpm --filter @workspace/api-server typecheck:tests"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-codegen-freshness"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:api-codegen-check && pnpm run check:api-codegen"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PASSWORD_RESET_FROM = "Garnish <no-reply@promptlingo.ai>"
