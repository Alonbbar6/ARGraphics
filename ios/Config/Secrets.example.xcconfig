// Copy to Secrets.xcconfig and fill in. Must match the API server's IOS_API_KEY.
ARGRAPHICS_API_BASE_URL = https:/$()/your-argraphics-host.example.com/api
ARGRAPHICS_IOS_API_KEY = replace-me
// The web host printed in QR codes (https://<host>/s/{code}).
ARGRAPHICS_ASSOCIATED_DOMAIN = your-argraphics-host.example.com
// Apple Developer team ID (developer.apple.com > Membership details).
ARGRAPHICS_TEAM_ID = ABCDE12345
